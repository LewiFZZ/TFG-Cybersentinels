# Copiar a .env y cambiar la contraseña:  cp .env.example .env

# --- Base de datos ---
DB_USER=urlsentinel
DB_PASSWORD=change_me
DB_NAME=urlsentinel

# --- Acceso web ---
# 127.0.0.1 = solo este equipo. 0.0.0.0 = toda la red (no hay login: cuidado).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Límite de peticiones por minuto e IP ---
THROTTLE_LIMIT=60

# --- APIs externas de reputación (opcionales) ---
# Sin clave, la fuente no se consulta y la herramienta es 100 % local.
# Con clave, la URL analizada se envía a ese servicio para consultar su reputación.
#   VirusTotal:           https://www.virustotal.com/gui/my-apikey
#   Google Safe Browsing: Google Cloud Console > APIs > "Safe Browsing API" > Credenciales
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# Tiempo máximo por API (ms) y horas que se reutiliza un resultado para la misma URL
REPUTATION_TIMEOUT_MS=4000
REPUTATION_CACHE_HOURS=24

# --- Solo desarrollo ---
DB_EXPOSED_PORT=5432
